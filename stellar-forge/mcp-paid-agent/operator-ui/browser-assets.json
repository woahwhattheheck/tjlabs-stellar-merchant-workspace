  "root": "./",
  "routes": [
    [
      "/console/",
      [
        "index.html",
        "text/html; charset=utf-8"
      ]
    ],
    [
      "/console/app.mjs",
      [
        "app.mjs",
        "text/javascript; charset=utf-8"
      ]
    ],
    [
      "/console/client.mjs",
