{
  "schema": "crm-migration.hubspot-host.v1",
  "connections": {
    "production": {
      "portalId": "123456",
      "tokenEnv": "CRM_HUBSPOT_ACCESS_TOKEN",
      "plan": {
        "schema": "crm-migration.hubspot-plan.v1",
        "apiVersion": "2026-09",
        "recordScope": "active",
        "propertySensitivity": "non_sensitive",
        "objects": [
          {
            "type": "contacts",
            "properties": [
              "email",
              "firstname",
              "lastname"
            ]
          },
          {
            "type": "companies",
            "properties": [
              "name",
              "domain"
            ]
          },
          {
            "type": "deals",
            "properties": [
              "dealname",
              "amount",
              "deal_currency_code",
              "dealstage"
            ]
          }
        ],
        "associations": [
          {
            "from": "contacts",
            "to": "companies"
          },
          {
            "from": "deals",
            "to": "contacts"
          }
        ]
      }
    }
  }
}
