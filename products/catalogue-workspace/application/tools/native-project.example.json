{
  "schema": "tjl.catalogue.native-project-config.v1",
  "site_key": "REPLACE_WITH_ACTUAL_SITE_ID",
  "project_root": "/REPLACE/actual-installed-project",
  "php_executable": "/REPLACE/actual-php-wrapper",
  "console": "bin/console",
  "kernel_class": "App\\Kernel",
  "environment": "REPLACE_WITH_ACTUAL_ENVIRONMENT",
  "connection": "REPLACE_WITH_ACTUAL_CONNECTION",
  "store_root": "/REPLACE/actual-private-catalogue-store",
  "roots": {
    "public": {
      "media": "/REPLACE/actual-public-media"
    },
    "private": {
      "catalogue": "/REPLACE/actual-private-catalogue-store",
      "files": "/REPLACE/actual-private-files"
    }
  },
  "queue_mode": "database",
  "maintenance_authorized": false,
  "host_private_paths": [
    "config/secrets/REPLACE_WITH_ACTUAL_ENVIRONMENT/REPLACE_WITH_PRIVATE_KEY"
  ],
  "excluded_runtime_paths": [
    "var/cache",
    "var/log"
  ],
  "max_bytes": 1099511627776,
  "commands": {
    "drain": {
      "argv": [
        "/REPLACE/actual-native-maintenance-command",
        "REPLACE_WITH_ORIGINAL_DRAIN_ARGUMENT"
      ]
    },
    "verify_drained": {
      "argv": [
        "/REPLACE/actual-native-drain-verifier"
      ]
    },
    "resume": {
      "argv": [
        "/REPLACE/actual-native-original-state-resumer"
      ]
    },
    "database_dump": {
      "argv": [
        "/REPLACE/actual-native-complete-sql-dump"
      ],
      "output": "stdout"
    },
    "database_import": {
      "argv": [
        "/REPLACE/actual-native-sql-import"
      ],
      "stdin": "{database_sql}"
    },
    "cache_rebuild": {
      "argv": [
        "{php}",
        "{console}",
        "cache:clear",
        "--env=REPLACE_WITH_ACTUAL_ENVIRONMENT",
        "--no-interaction"
      ]
    },
    "verify_reopen": {
      "argv": [
        "/REPLACE/actual-native-schema-queue-health-verifier"
      ]
    }
  }
}
