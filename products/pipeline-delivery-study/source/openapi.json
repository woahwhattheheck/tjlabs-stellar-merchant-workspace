ogress","description":"share of tasks approved, 0..1"},"deadline":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Deadline"},"created_at":{"type":"string","format":"date-time","title":"Created At"},"delivered_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Delivered At"}},"type":"object","required":["id","mode","test","name","status","workspace","labels","tasks","progress","deadline","created_at","delivered_at"],"title":"AnnotationJobOut"},"Body_upload_files_v1_annotation_jobs__job_id__files_post":{"properties":{"files":{"items":{"type":"string","contentMediaType":"application/octet-stream"},"type":"array","title":"Files"},"task_per":{"type":"string","enum":["file","upload"],"title":"Task Per","default":"file"},"name":{"type":"string","title":"Name","default":""}},"type":"object","required":["files"],"title":"Body_upload_files_v1_annotation_jobs__job_id__files_post"},"BucketSource":{"properties":{"type":{"type":"string","const":"bucket","title":"Type","default":"bucket"},"connection_id":{"type":"string","maxLength":32,"title":"Connection Id"},"prefix":{"type":"string","maxLength":1000,"title":"Prefix","description":"inside the connection's own prefix","default":""},"episodes":{"anyOf":[{"items":{"type":"integer"},"type":"array","maxItems":10000},{"type":"null"}],"title":"Episodes","description":"LeRobot: only these indexes"},"max_episodes":{"anyOf":[{"type":"integer","maximum":100000.0,"minimum":1.0},{"type":"null"}],"title":"Max Episodes"}},"type":"object","required":["connection_id"],"title":"BucketSource","description":"A prefix in your bucket (a connection: AWS S3, Google Cloud Storage, Cloudflare R2, any\nS3-compatible). A LeRobot dataset there (meta/info.json) is read as such; otherwise every\nepisode file under the prefix is an episode."},"ConnectionIn":{"properties":{"kind":{"type":"string","enum":["s3","database"],"title":"Kind"},"name":{"type":"string","maxLength":200,"title":"Name","default":""},"p