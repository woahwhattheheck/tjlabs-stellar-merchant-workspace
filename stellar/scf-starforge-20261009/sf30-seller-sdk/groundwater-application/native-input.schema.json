{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stellar-forge.groundwater-application.v1.native-receiving",
  "title": "Groundwater scientific Applications receiving",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operationId",
    "actor",
    "reason",
    "runtimeWorkspaceDirectory",
    "runtimeDirectory",
    "expectedSourceCommit",
    "workspaceDirectory",
    "expectedWorkspaceId",
    "receivingDirectory",
    "python",
    "archive",
    "originalOperationIds",
    "outputDirectory",
    "browser"
  ],
  "properties": {
    "schema": {
      "const": "stellar-forge.groundwater-application.v1.native-receiving"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "runtimeWorkspaceDirectory": {
      "type": "string",
      "pattern": "^/"
    },
    "runtimeDirectory": {
      "type": "string",
      "pattern": "^/"
    },
    "workspaceDirectory": {
      "type": "string",
      "pattern": "^/"
    },
    "receivingDirectory": {
      "type": "string",
      "pattern": "^/"
    },
    "python": {
      "type": "string",
      "pattern": "^/"
    },
    "outputDirectory": {
      "type": "string",
      "pattern": "^/"
    },
    "expectedSourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expectedWorkspaceId": {
      "type": "string",
      "minLength": 1
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "originalOperationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "executable"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^/"
        },
        "executable": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "waitMilliseconds": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 600000
    },
    "allowClosedLaunchRetry": {
      "type": "boolean",
      "default": false,
      "description": "Permit a next numbered managed launch only after the exact previous native run is proved closed before browser observation. It never creates another scientific run or backup."
    }
  }
}
