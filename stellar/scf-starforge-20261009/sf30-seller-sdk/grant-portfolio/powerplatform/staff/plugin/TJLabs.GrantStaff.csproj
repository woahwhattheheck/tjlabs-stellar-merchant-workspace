<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TJLabs.GrantStaff</AssemblyName>
    <RootNamespace>TJLabs.GrantStaff</RootNamespace>
    <AssemblyVersion>$(PMRS_ASSEMBLY_VERSION)</AssemblyVersion>
    <FileVersion>$(PMRS_ASSEMBLY_VERSION)</FileVersion>
    <Version>$(PMRS_ASSEMBLY_VERSION)</Version>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <PublicSign>false</PublicSign>
    <AssemblyOriginatorKeyFile>$(PMRS_SIGNING_KEY_FILE)</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StrictJson.cs" />
    <Compile Include="StaffContract.cs" />
    <Compile Include="StaffWorkflow.cs" />
    <Compile Include="StaffApi.cs" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="[9.0.2.60]" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="[1.0.3]" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CheckSelectedBuildInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(PMRS_ASSEMBLY_VERSION)' == ''" Text="The actual selected four-part assembly version is required." />
    <Error Condition="'$(PMRS_SIGNING_KEY_FILE)' == ''" Text="Select the original external strong-name signing key." />
    <Error Condition="!Exists('$(PMRS_SIGNING_KEY_FILE)')" Text="The selected original strong-name key is absent." />
  </Target>
</Project>
