{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected data.gouv.fr draft publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "organizationId",
    "dataset",
    "resources"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{24}$"
    },
    "datasetId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{24}$"
    },
    "dataset": {
      "type": "object",
      "required": [
        "title",
        "description",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Native data.gouv.fr dataset title value."
        },
        "description": {
          "description": "Native data.gouv.fr dataset description value."
        },
        "description_short": {
          "description": "Native data.gouv.fr dataset description_short value."
        },
        "acronym": {
          "description": "Native data.gouv.fr dataset acronym value."
        },
        "license": {
          "description": "Native data.gouv.fr dataset license value."
        },
        "frequency": {
          "description": "Native data.gouv.fr dataset frequency value."
        },
        "frequency_date": {
          "description": "Native data.gouv.fr dataset frequency_date value."
        },
        "temporal_coverage": {
          "description": "Native data.gouv.fr dataset temporal_coverage value."
        },
        "spatial": {
          "description": "Native data.gouv.fr dataset spatial value."
        },
        "tags": {
          "description": "Native data.gouv.fr dataset tags value."
        },
        "extras": {
          "description": "Native data.gouv.fr dataset extras value."
        },
        "contact_points": {
          "description": "Native data.gouv.fr dataset contact_points value."
        },
        "access_type": {
          "description": "Native data.gouv.fr dataset access_type value."
        },
        "access_audiences": {
          "description": "Native data.gouv.fr dataset access_audiences value."
        },
        "authorization_request_url": {
          "description": "Native data.gouv.fr dataset authorization_request_url value."
        },
        "access_type_reason_category": {
          "description": "Native data.gouv.fr dataset access_type_reason_category value."
        },
        "access_type_reason": {
          "description": "Native data.gouv.fr dataset access_type_reason value."
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "mode",
          "metadata"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "mode": {
            "enum": [
              "file",
              "remote"
            ]
          },
          "metadata": {
            "type": "object",
            "required": [
              "title",
              "type",
              "format"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "description": "Native resource title value."
              },
              "description": {
                "description": "Native resource description value."
              },
              "type": {
                "description": "Native resource type value."
              },
              "format": {
                "description": "Native resource format value."
              },
              "mime": {
                "description": "Native resource mime value."
              },
              "schema": {
                "description": "Native resource schema value."
              },
              "extras": {
                "description": "Native resource extras value."
              }
            }
          },
          "file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute selected original file path."
              },
              "filename": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checksum": {
            "type": [
              "object",
              "null"
            ]
          },
          "filesize": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "file"
                }
              }
            },
            "then": {
              "required": [
                "file"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "remote"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "required": [
                  "file"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
