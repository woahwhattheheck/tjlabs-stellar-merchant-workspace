/** Original retained NOAA source inspection; all monetary-free source values remain exact text. */
export interface PointReference { recordId:string; sourcePageSha256:string; sourceRecord:string; rowSha256:string }
export interface InspectionSelection { product?:'water_level'|'hourly_height'|'predictions'; beginDate?:string; endDate?:string; buckets?:number; table?:'observations'|'predictions'; products?:string[] }
export interface SelectedInspection extends InspectionSelection { product:'water_level'|'hourly_height'|'predictions'; beginDate:string; endDate:string; buckets:number; table:'observations'|'predictions'; products:string[] }
export interface OriginalPoint extends PointReference { timestamp:string; timestampUtc:string; value:string; valueType:string; unit:string; quality:string; flags:string; sigma:string; eventType:string; plotValue:number|null }
export interface SourceIdentity { editionId:string; sourceSha256:string; editionSha256:string; stationId:string; stationName:string|null; datum:string; units:string; unit:string; timeZone:string; query:Record<string,unknown> }
export interface InspectionCounts { records:number; numericRecords:number; unavailableRecords:number; unplottableRecords:number; invalidClockRecords:number; offGridRecords:number; uniqueTimestampKeys:number; duplicateTimestampKeys:number; duplicateRecords:number; conflictingTimestampKeys:number; expectedSlots:number|null; presentSlots:number|null; numericSlots:number|null; missingSlots:number|null; slotsWithoutNumericValue:number|null }
export interface InspectionBin { index:number; beginClock:string; endExclusiveClock:string; records:number; numericRecords:number; unavailableRecords:number; unplottableRecords:number; expectedSlots:number|null; presentSlots:number|null; numericSlots:number|null; missingSlots:number|null; slotsWithoutNumericValue:number|null; first:OriginalPoint|null; last:OriginalPoint|null; minimum:OriginalPoint|null; maximum:OriginalPoint|null; quality:Record<string,number> }
export interface Inspection { schema:'stellar-forge.coops-observation-inspection.v1'; inspectionSha256:string; source:SourceIdentity; selection:SelectedInspection; clockBasis:string; grid:{stepMinutes:number|null;expectedBasis:string}; counts:InspectionCounts; quality:Record<string,number>; valueTypes:Record<string,number>; minimum:OriginalPoint|null; maximum:OriginalPoint|null; bins:InspectionBin[]; sources:Record<string,unknown>[]; sourceTasks:Record<string,unknown>[]; sourceRequestsComplete:boolean; warnings:string[]; notes:string[] }
export interface PointInspection { schema:'stellar-forge.coops-observation-point.v1'; source:SourceIdentity; reference:PointReference; pageIndex:number; receipt:Record<string,unknown>; row:Record<string,string>; original:Record<string,unknown> }
export interface InspectionReviewInput { selection:InspectionSelection; expectedInspectionSha256:string; points?:PointReference[] }
export interface InspectionReviewEvidence extends Omit<Inspection,'schema'|'bins'|'sourceRequestsComplete'> { schema:'stellar-forge.coops-observation-review-evidence.v1'; points:{reference:PointReference;row:Record<string,string>;receipt:Record<string,unknown>;pageIndex:number}[] }
export const INSPECTION_SCHEMA:'stellar-forge.coops-observation-inspection.v1';
export const INSPECTION_LIMITS:{buckets:480;identityKeys:200000;selectedPoints:32;gridSlots:2000000};
export function inspectionSelection(edition:Record<string,any>,input?:InspectionSelection):SelectedInspection;
export function inspectionPointReference(value:PointReference):PointReference;
export function inspectEdition(store:any,edition:Record<string,any>,input?:InspectionSelection):Promise<Inspection>;
export function inspectPoint(store:any,edition:Record<string,any>,reference:PointReference):Promise<PointInspection>;
export function inspectRows(store:any,edition:Record<string,any>,input?:InspectionSelection,options?:{offset?:number;limit?:number}):Promise<{schema:'stellar-forge.coops-observation-page.v1';source:SourceIdentity;selection:SelectedInspection;offset:number;total:number;rows:{row:Record<string,string>;reference:PointReference}[]}>;
export function inspectionEvidence(store:any,edition:Record<string,any>,input:InspectionReviewInput):Promise<InspectionReviewEvidence>;
