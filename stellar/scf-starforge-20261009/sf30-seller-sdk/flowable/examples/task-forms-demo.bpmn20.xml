<?xml version="1.0" encoding="UTF-8"?>
<!-- MIT. TJLabs explicit isolated native task-form demonstration; no customer records. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://tokenjunkielabs.com/flowable/native-task-forms">
 <process id="tjlabs_task_forms" name="TJLabs original typed native task form" isExecutable="true">
  <startEvent id="start"/>
  <sequenceFlow id="startToReview" sourceRef="start" targetRef="review"/>
  <userTask id="review" name="Review original native form">
   <extensionElements>
    <flowable:formProperty id="reference" name="Reference" type="string" required="true"/>
    <flowable:formProperty id="quantity" name="Exact signed long" type="long" required="true"/>
    <flowable:formProperty id="approved" name="Approved" type="boolean"/>
    <flowable:formProperty id="scheduled" name="Native date" type="date" datePattern="dd/MM/yyyy"/>
    <flowable:formProperty id="category" name="Category" type="enum">
     <flowable:value id="tier-a" name="Standard priority"/>
     <flowable:value id="tier-b" name="Business priority"/>
    </flowable:formProperty>
    <flowable:formProperty id="comment" name="Omitted value stays original" type="string"/>
    <flowable:formProperty id="blankString" name="Explicit empty string" type="string"/>
    <flowable:formProperty id="clearLong" name="Explicit null long" type="long"/>
    <flowable:formProperty id="lockedCode" name="Read-only original code" type="string" writable="false"/>
    <flowable:formProperty id="hiddenToken" name="Native hidden default" type="string" readable="false" required="true" default="native-default"/>
   </extensionElements>
  </userTask>
  <sequenceFlow id="reviewToEnd" sourceRef="review" targetRef="end"/>
  <endEvent id="end"/>
 </process>
 <process id="tjlabs_form_key_only" name="TJLabs explicit external-form-key view" isExecutable="true">
  <startEvent id="keyStart"/>
  <sequenceFlow id="keyStartToTask" sourceRef="keyStart" targetRef="keyTask"/>
  <userTask id="keyTask" name="Inspect original form key only" flowable:formKey="tjlabs:retained-custom-form"/>
  <sequenceFlow id="keyTaskToEnd" sourceRef="keyTask" targetRef="keyEnd"/>
  <endEvent id="keyEnd"/>
 </process>
</definitions>
