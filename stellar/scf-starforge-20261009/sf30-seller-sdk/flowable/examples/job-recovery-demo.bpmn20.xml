<?xml version="1.0" encoding="UTF-8"?>
<!-- MIT. TJLabs isolated native demonstration; never a customer process. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://tjlabs.com/flowable/job-recovery">
  <process id="tjlabs_job_failure" name="TJLabs native failure and explicit repair" isExecutable="true">
    <startEvent id="start"/><sequenceFlow id="s1" sourceRef="start" targetRef="needsRepair"/>
    <serviceTask id="needsRepair" name="Read explicitly missing repair input" flowable:async="true" flowable:expression="${execution.getVariable('repairValue').toString()}">
      <extensionElements><flowable:failedJobRetryTimeCycle>R1/PT1S</flowable:failedJobRetryTimeCycle></extensionElements>
    </serviceTask>
    <sequenceFlow id="s2" sourceRef="needsRepair" targetRef="end"/><endEvent id="end"/>
  </process>
  <process id="tjlabs_job_timer" name="TJLabs explicit timer recovery" isExecutable="true">
    <startEvent id="start"/><sequenceFlow id="t1" sourceRef="start" targetRef="wait"/>
    <intermediateCatchEvent id="wait" name="Thirty-day demonstration timer"><timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <sequenceFlow id="t2" sourceRef="wait" targetRef="end"/><endEvent id="end"/>
  </process>
  <process id="tjlabs_job_executable" name="TJLabs retained executable job" isExecutable="true">
    <startEvent id="start"/><sequenceFlow id="e1" sourceRef="start" targetRef="ready"/>
    <serviceTask id="ready" name="Native no-op expression" flowable:async="true" flowable:expression="${true}"/>
    <sequenceFlow id="e2" sourceRef="ready" targetRef="end"/><endEvent id="end"/>
  </process>
  <process id="tjlabs_job_suspended" name="TJLabs native suspended job" isExecutable="true">
    <startEvent id="start"/><sequenceFlow id="u1" sourceRef="start" targetRef="ready"/>
    <serviceTask id="ready" name="Suspended native no-op expression" flowable:async="true" flowable:expression="${true}"/>
    <sequenceFlow id="u2" sourceRef="ready" targetRef="end"/><endEvent id="end"/>
  </process>
</definitions>
