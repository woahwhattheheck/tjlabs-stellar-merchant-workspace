    "<mapping>\n        <path>//iati-organisation/recipient-region-budget/value/@currency</path>\n        <codelist ref=\"Currency\" />\n    </mapping>",
    "<mapping>\n        <path>//iati-organisation/reporting-org/@type</path>\n        <codelist ref=\"OrganisationType\" />\n    </mapping>",
    "<mapping>\n        <path>//iati-organisation/total-budget/@status</path>\n        <codelist ref=\"BudgetStatus\" />\n    </mapping>",
    "<mapping>\n        <path>//iati-organisation/total-budget/value/@currency</path>\n        <codelist ref=\"Currency\" />\n    </mapping>"
  ],
  "notes": [
    "The complete upstream mapping remains unchanged. Monetary values in total-expenditure and line items use the common value definition; the core owner retains its full currency handling.",
    "Region codes use the Region codelist only for default/OECD DAC vocabulary1. Other vocabularies retain their supplied URI and original code.",
    "Country and Language are explicitly incomplete upstream codelists; absence from them is not proof of invalidity."
  ]
}
