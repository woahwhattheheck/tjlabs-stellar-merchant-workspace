{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woahwhattheheck/tjlabs-stellar-merchant-workspace/stellar-forge/iati-programme-commissioning.v1",
  "title": "Original IATI Results programme commissioning input",
  "description": "Complete commissioning envelope. Original Results.preview validates the unchanged native definition and source selection. The Python module additionally verifies complete evidence bytes, native record relationships and explicit state encodings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "programme",
    "definition",
    "sourcePins",
    "evidence",
    "recordScopes",
    "projects",
    "fields",
    "values"
  ],
  "properties": {
    "schema": {
      "const": "stellar-forge.iati-programme-commissioning.v1"
    },
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "organisationRef",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "organisationRef": {
          "type": "string",
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 16000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "selection": {
          "type": "object"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewer",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "draft",
                "reviewed",
                "needs-correction"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "sourcePins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "bytes",
          "projectionSha256"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "projectionSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "sha256",
          "bytes",
          "observedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "rsr-json",
              "rsr-ui",
              "framework",
              "operator-statement"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "observedAt": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "recordScopes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "objectId",
          "evidenceId",
          "pointer",
          "idPointer",
          "ownerScopeId",
          "ownerPointer",
          "parentScopeId",
          "parentPointer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "project",
              "result",
              "indicator",
              "period",
              "actual",
              "disaggregation"
            ]
          },
          "objectId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "pointer": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "pattern": "^(?:/(?:[^~]|~[01])*)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "idPointer": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "pattern": "^/(?:[^~]|~[01])*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownerScopeId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownerPointer": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "pattern": "^/(?:[^~]|~[01])*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentScopeId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentPointer": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "pattern": "^/(?:[^~]|~[01])*$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parentId",
          "role",
          "activityKeys",
          "recordScopeId",
          "idFact",
          "parentFact",
          "note"
        ],
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            ]
          },
          "parentId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "core",
              "contributing",
              "sub-contributing",
              "standalone",
              "unknown"
            ]
          },
          "activityKeys": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 100000,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "recordScopeId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "idFact": {
            "$ref": "#/$defs/fact"
          },
          "parentFact": {
            "$ref": "#/$defs/fact"
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "values": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valueKey",
          "projectId",
          "objectId",
          "coreIndicatorId",
          "recordScopeId",
          "periodScopeId",
          "periodObjectId",
          "approval",
          "approvalFact",
          "approvalBinding",
          "periodState",
          "periodFact",
          "periodBinding",
          "contributionRole",
          "aggregateGroup",
          "includesValueKeys",
          "note"
        ],
        "properties": {
          "valueKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "projectId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "objectId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "coreIndicatorId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "recordScopeId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "periodScopeId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "periodObjectId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "approval": {
            "enum": [
              "unknown",
              "draft",
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "approvalFact": {
            "$ref": "#/$defs/fact"
          },
          "approvalBinding": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "nativeValue",
                  "note"
                ],
                "properties": {
                  "encoding": {
                    "enum": [
                      "canonical-text",
                      "unmapped"
                    ]
                  },
                  "nativeValue": {},
                  "note": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "periodState": {
            "enum": [
              "unknown",
              "locked",
              "unlocked"
            ]
          },
          "periodFact": {
            "$ref": "#/$defs/fact"
          },
          "periodBinding": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "encoding",
                  "nativeValue",
                  "note"
                ],
                "properties": {
                  "encoding": {
                    "enum": [
                      "canonical-text",
                      "unmapped",
                      "locked-boolean",
                      "unlocked-boolean"
                    ]
                  },
                  "nativeValue": {},
                  "note": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "contributionRole": {
            "enum": [
              "unknown",
              "standalone",
              "component",
              "aggregate"
            ]
          },
          "aggregateGroup": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "includesValueKeys": {
            "type": "array",
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "pointer",
            "expectedPresent",
            "expectedValue",
            "scopeId"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "pointer": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 4000,
                  "pattern": "^(?:/(?:[^~]|~[01])*)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expectedPresent": {
              "type": "boolean"
            },
            "expectedValue": {},
            "scopeId": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "expectedPresent": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "expectedValue": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence",
        "value",
        "fact"
      ],
      "properties": {
        "presence": {
          "enum": [
            "unknown",
            "absent",
            "present"
          ]
        },
        "value": {},
        "fact": {
          "$ref": "#/$defs/fact"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "presence": {
                "enum": [
                  "unknown",
                  "absent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "fact",
        "binding"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "allowed",
            "denied"
          ]
        },
        "fact": {
          "$ref": "#/$defs/fact"
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "nativeValue",
                "note"
              ],
              "properties": {
                "encoding": {
                  "enum": [
                    "canonical-text",
                    "unmapped",
                    "permission-boolean"
                  ]
                },
                "nativeValue": {},
                "note": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "subjectKey",
        "entity",
        "objectId",
        "parentObjectId",
        "recordScopeId",
        "parentScopeId",
        "recordPresence",
        "recordFact",
        "field",
        "action",
        "child",
        "parent",
        "permission",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "projectId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          ]
        },
        "subjectKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entity": {
          "enum": [
            "result",
            "indicator",
            "period",
            "disaggregation"
          ]
        },
        "objectId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "parentObjectId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "recordScopeId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentScopeId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordPresence": {
          "enum": [
            "unknown",
            "absent",
            "present"
          ]
        },
        "recordFact": {
          "$ref": "#/$defs/fact"
        },
        "field": {
          "type": "string"
        },
        "action": {
          "enum": [
            "inspect",
            "initial-inherit",
            "parent-change",
            "reimport",
            "child-change"
          ]
        },
        "child": {
          "$ref": "#/$defs/observation"
        },
        "parent": {
          "$ref": "#/$defs/observation"
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entity": {
                "const": "result"
              }
            }
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "title",
                  "type",
                  "aggregation-status",
                  "description"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "indicator"
              }
            }
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "title",
                  "description",
                  "baseline-year",
                  "baseline-value",
                  "baseline-comment",
                  "dimension",
                  "dimension-value"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "period"
              }
            }
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "target-value",
                  "target-comment",
                  "actual-value",
                  "actual-comment",
                  "start",
                  "end",
                  "locked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "disaggregation"
              }
            }
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "title",
                  "value-name"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
