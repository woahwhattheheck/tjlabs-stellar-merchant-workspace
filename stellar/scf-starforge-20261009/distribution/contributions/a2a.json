{
  "schema": "stellar-forge.merchant-distribution-contribution.v1",
  "id": "a2a",
  "description": "Original A2A 1.0 task workspace, complete source custody and native merchant result editions.",
  "commands": {
    "a2a": "stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/cli.mjs",
    "a2a-analysis": "stellar-forge/a2a-analysis-agent/cli.mjs",
    "a2a-receive": "stellar-forge/a2a-analysis-agent/receive.mjs"
  },
  "commandDescriptions": {
    "a2a": "Retain original A2A agent tasks, review complete artifacts and publish a source-bound result through SF30/SF82.",
    "a2a-analysis": "Serve the original saved AnalysisWorkspace procedures through the official A2A SDK.",
    "a2a-receive": "Receive complete original analysis files using the standard A2A SDK client."
  },
  "exports": {
    "./a2a": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/workspace.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/workspace.mjs"
    },
    "./a2a/transport": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/transport.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/transport.mjs"
    },
    "./a2a/portable": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/portable.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/portable.mjs"
    },
    "./a2a/merchant": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/merchant.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/merchant.mjs"
    },
    "./a2a/server": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/server.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/server.mjs"
    },
    "./a2a/cli": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/cli.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/cli.mjs"
    },
    "./a2a/release": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/release.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/release.mjs"
    },
    "./a2a/sf82": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/sf82.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/sf82.mjs"
    },
    "./a2a-analysis/service": "./source/stellar-forge/a2a-analysis-agent/service.mjs",
    "./a2a-analysis/config": "./source/stellar-forge/a2a-analysis-agent/config.mjs",
    "./a2a-analysis/native": "./source/stellar-forge/a2a-analysis-agent/native.mjs",
    "./a2a-analysis/receive": "./source/stellar-forge/a2a-analysis-agent/receive.mjs"
  },
  "applicationProviders": {
    "a2a": "stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/application-provider.mjs"
  },
  "components": [
    "stellar/scf-starforge-20261009/sf30-seller-sdk/a2a",
    "stellar-forge/a2a-analysis-agent"
  ],
  "supportFiles": [
    "stellar/scf-starforge-20261009/sf82-seller-pilot/releases.mjs",
    "stellar/scf-starforge-20261009/sf82-seller-pilot/release-source-contracts.mjs"
  ],
  "runtimePackageManifests": {
    "a2a": "stellar/scf-starforge-20261009/sf30-seller-sdk/a2a/runtime-package.json",
    "a2a-analysis": "stellar-forge/a2a-analysis-agent/package.json"
  },
  "featurePeers": {
    "a2a": {
      "@a2a-js/sdk": {
        "version": "1.3.0",
        "probe": "@a2a-js/sdk/client"
      },
      "jose": {
        "version": "6.2.12",
        "probe": "jose"
      }
    },
    "a2a-analysis": {
      "@a2a-js/sdk": {
        "version": "1.3.0",
        "probe": "@a2a-js/sdk/server"
      },
      "express": {
        "version": "5.1.0",
        "probe": "express"
      },
      "kysely": {
        "version": "0.29.5",
        "probe": "kysely"
      },
      "better-sqlite3": {
        "version": "13.0.3",
        "probe": "better-sqlite3",
        "native": "sqlite"
      }
    }
  }
}
