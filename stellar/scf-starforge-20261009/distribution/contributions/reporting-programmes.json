    "products/source-tables/reporting/desk-receive.mjs",
    "products/source-tables/reporting/desk-receive.d.mts",
    "products/source-tables/reporting/workbench.html",
    "products/source-tables/reporting/workbench.mjs",
    "products/source-tables/reporting/workbench.css",
    "products/source-tables/reporting/workbench-model.mjs",
    "products/source-tables/reporting/workbench-server.mjs",
    "products/source-tables/reporting/workbench-application.mjs",
    "products/source-tables/reporting/WORKBENCH.md"
