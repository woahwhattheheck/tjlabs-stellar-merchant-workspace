    "products/document-merchant/APPLICATIONS.md",
    "products/document-merchant/launch.d.mts",
    "products/document-merchant/COMPOSITION.md",
    "products/document-merchant/composition.d.mts",
    "products/document-merchant/BATCHES.md",
    "products/document-merchant/batch.d.mts",
    "products/document-merchant/batch-render.d.mts",
    "products/document-merchant/examples/composition/orders.json",
    "products/document-merchant/examples/composition/invoice.html",
    "products/document-merchant/examples/composition/greeting.html",
    "products/document-merchant/examples/composition/order-documents.json",
    "products/document-merchant/examples/composition/order-lines.csv",
    "products/document-merchant/examples/composition/grouped-order-documents.json",
    "products/document-merchant/examples/composition/reports.csv",
