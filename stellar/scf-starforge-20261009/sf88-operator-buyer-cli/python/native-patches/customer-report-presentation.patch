+const valueView=value=>{
+  if(!value||value.kind==='missing')return '<p>Not present</p>';
+  const type={number:'Exact number',string:'String',boolean:'Boolean',null:'Null value',column:'Column'}[value.kind];
+  const primary=value.kind==='number'?value.literal:value.kind==='string'||value.kind==='column'?json(value.value):
+    value.kind==='boolean'?String(value.value):value.kind==='null'?'null':json(value,null,2);
+  return (type?'<small>'+html(type)+'</small>':'')+'<pre>'+html(primary)+'</pre>';
+};
